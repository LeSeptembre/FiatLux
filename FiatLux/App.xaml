<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FiatLux"
             x:Class="FiatLux.App">
    <Application.Resources>
        <ResourceDictionary>
            
            <!-- Color Palette -->
            <Color x:Key="BackgroundPrimary">#0A0A0A</Color>
            <Color x:Key="BackgroundSecondary">#1A1A1A</Color>
            <Color x:Key="BackgroundTertiary">#2A2A2A</Color>
            
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#6B6B6B</Color>
            <Color x:Key="TextTertiary">#3A3A3A</Color>
            
            <Color x:Key="AccentPrimary">#FFFFFF</Color>
            <Color x:Key="BorderColor">#2A2A2A</Color>

            <!-- Converters -->
            <local:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <local:BoolToConnectionColorConverter x:Key="BoolToConnectionColorConverter"/>
            <local:BoolToManualModeColorConverter x:Key="BoolToManualModeColorConverter"/>
            <local:StatusToColorConverter x:Key="StatusToColorConverter"/>
            <local:LampStatusToColorConverter x:Key="LampStatusToColorConverter"/>
            <local:TimestampToDateConverter x:Key="TimestampToDateConverter"/>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
