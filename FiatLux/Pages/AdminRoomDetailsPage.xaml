<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FiatLux.Pages.AdminRoomDetailsPage"
             xmlns:models="clr-namespace:FiatLux.Models"
             BackgroundColor="#0A0A0A">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Padding="24,0,24,24">

            <!-- Header with Back Button -->
            <Grid Grid.Row="0" 
                  ColumnDefinitions="Auto,*"
                  Margin="0,60,0,24">

                <Border Grid.Column="0"
                        BackgroundColor="#1A1A1A"
                        StrokeThickness="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        Margin="0,0,16,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="24"
                           TextColor="#FFFFFF"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" 
                                   Spacing="4"
                                   VerticalOptions="Center">
                    <Label Text="{Binding RoomId, StringFormat='Room {0}'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           TextColor="#FFFFFF"/>
                    <Label Text="Admin Controls"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           TextColor="#EF4444"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Manual Mode Toggle -->
            <Border Grid.Row="1"
                    BackgroundColor="#1A1A1A"
                    StrokeThickness="1"
                    Stroke="#2A2A2A"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Manual Mode"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               TextColor="#FFFFFF"/>
                        <Label Text="Override automatic lighting control"
                               FontFamily="OpenSansRegular"
                               FontSize="12"
                               TextColor="#6B6B6B"/>
                    </VerticalStackLayout>

                    <Switch Grid.Column="1"
                            IsToggled="{Binding IsManualMode}"
                            OnColor="#EF4444"
                            ThumbColor="#FFFFFF"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Manual Target Input -->
            <Border Grid.Row="2"
                    BackgroundColor="#1A1A1A"
                    StrokeThickness="1"
                    Stroke="#2A2A2A"
                    Padding="20,16"
                    Margin="0,0,0,24"
                    IsVisible="{Binding IsManualMode}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="12">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                        <Label Text="Manual Target"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               TextColor="#FFFFFF"/>
                        <Label Text="Set custom brightness level (lux)"
                               FontFamily="OpenSansRegular"
                               FontSize="12"
                               TextColor="#6B6B6B"/>
                    </VerticalStackLayout>

                    <Border Grid.Row="0" Grid.Column="1"
                            BackgroundColor="#2A2A2A"
                            StrokeThickness="0"
                            WidthRequest="100"
                            HeightRequest="44"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding ManualTarget}"
                               Keyboard="Numeric"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="#FFFFFF"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center"
                               BackgroundColor="Transparent"/>
                    </Border>

                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Text="Apply Target"
                            Command="{Binding ApplyManualTargetCommand}"
                            BackgroundColor="#EF4444"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            HeightRequest="44"
                            CornerRadius="8"/>
                </Grid>
            </Border>

            <!-- Sensors Section -->
            <VerticalStackLayout Grid.Row="3" Spacing="12" Margin="0,0,0,24">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <Label Grid.Column="0"
                           Text="Sensors"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           TextColor="#FFFFFF"
                           VerticalOptions="Center"/>
                    <Border Grid.Column="1"
                            BackgroundColor="#2A2A2A"
                            StrokeThickness="0"
                            Padding="8,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Sensors.Count, StringFormat='{0} connected'}"
                               FontFamily="OpenSansRegular"
                               FontSize="12"
                               TextColor="#6B6B6B"/>
                    </Border>
                </Grid>

                <CollectionView ItemsSource="{Binding Sensors}">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="#1A1A1A"
                                StrokeThickness="1"
                                Stroke="#2A2A2A"
                                Padding="20"
                                Margin="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="No sensors detected"
                                   FontFamily="OpenSansRegular"
                                   FontSize="14"
                                   TextColor="#6B6B6B"
                                   HorizontalOptions="Center"/>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Sensor">
                            <Border BackgroundColor="#1A1A1A"
                                    StrokeThickness="1"
                                    Stroke="#2A2A2A"
                                    Padding="16"
                                    Margin="0,0,0,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>

                                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                                    <!-- Header Row -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                        <BoxView Grid.Column="0"
                                                 WidthRequest="8"
                                                 HeightRequest="8"
                                                 CornerRadius="4"
                                                 Color="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                 VerticalOptions="Center"
                                                 Margin="0,0,12,0"/>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding SensorId}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="15"
                                                   TextColor="#FFFFFF"/>
                                            <Label Text="{Binding Status}"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="11"
                                                   TextColor="#6B6B6B"/>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" 
                                                           HorizontalOptions="End"
                                                           Spacing="0">
                                            <Label Text="{Binding Value, StringFormat='{0:F1}'}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="22"
                                                   TextColor="#FFFFFF"
                                                   HorizontalOptions="End"/>
                                            <Label Text="lux"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="11"
                                                   TextColor="#6B6B6B"
                                                   HorizontalOptions="End"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Info Row -->
                                    <Grid Grid.Row="1" 
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#0A0A0A"
                                                StrokeThickness="0"
                                                Padding="8,6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Last Update"
                                                       FontFamily="OpenSansRegular"
                                                       FontSize="10"
                                                       TextColor="#6B6B6B"/>
                                                <Label Text="{Binding LastUpdate, Converter={StaticResource TimestampToDateConverter}}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="11"
                                                       TextColor="#FFFFFF"/>
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Column="1"
                                                BackgroundColor="#0A0A0A"
                                                StrokeThickness="0"
                                                Padding="8,6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Type"
                                                       FontFamily="OpenSansRegular"
                                                       FontSize="10"
                                                       TextColor="#6B6B6B"/>
                                                <Label Text="{Binding Type}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="11"
                                                       TextColor="#FFFFFF"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Lamps Section -->
            <VerticalStackLayout Grid.Row="4" Spacing="12">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <Label Grid.Column="0"
                           Text="Lamps"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           TextColor="#FFFFFF"
                           VerticalOptions="Center"/>
                    <Border Grid.Column="1"
                            BackgroundColor="#2A2A2A"
                            StrokeThickness="0"
                            Padding="8,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Lamps.Count, StringFormat='{0} connected'}"
                               FontFamily="OpenSansRegular"
                               FontSize="12"
                               TextColor="#6B6B6B"/>
                    </Border>
                </Grid>

                <CollectionView ItemsSource="{Binding Lamps}">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="#1A1A1A"
                                StrokeThickness="1"
                                Stroke="#2A2A2A"
                                Padding="20"
                                Margin="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="No lamps detected"
                                   FontFamily="OpenSansRegular"
                                   FontSize="14"
                                   TextColor="#6B6B6B"
                                   HorizontalOptions="Center"/>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Lamp">
                            <Border BackgroundColor="#1A1A1A"
                                    StrokeThickness="1"
                                    Stroke="#2A2A2A"
                                    Padding="16"
                                    Margin="0,0,0,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>

                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                    <!-- Header Row -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                        <BoxView Grid.Column="0"
                                                 WidthRequest="8"
                                                 HeightRequest="8"
                                                 CornerRadius="4"
                                                 Color="{Binding Status, Converter={StaticResource LampStatusToColorConverter}}"
                                                 VerticalOptions="Center"
                                                 Margin="0,0,12,0"/>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding LampId}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="15"
                                                   TextColor="#FFFFFF"/>
                                            <Label Text="{Binding Status}"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="11"
                                                   TextColor="#6B6B6B"/>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" 
                                                           HorizontalOptions="End"
                                                           Spacing="0">
                                            <Label Text="{Binding Power, StringFormat='{0}%'}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="22"
                                                   TextColor="#FFFFFF"
                                                   HorizontalOptions="End"/>
                                            <Label Text="brightness"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="11"
                                                   TextColor="#6B6B6B"
                                                   HorizontalOptions="End"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Progress Bar -->
                                    <ProgressBar Grid.Row="1"
                                                 Progress="{Binding Power, Converter={StaticResource PercentToProgressConverter}}"
                                                 ProgressColor="#EF4444"
                                                 BackgroundColor="#0A0A0A"
                                                 HeightRequest="6"
                                                 Margin="0,4,0,0"/>

                                    <!-- Info Row -->
                                    <Grid Grid.Row="2" 
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#0A0A0A"
                                                StrokeThickness="0"
                                                Padding="8,6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Last Update"
                                                       FontFamily="OpenSansRegular"
                                                       FontSize="10"
                                                       TextColor="#6B6B6B"/>
                                                <Label Text="{Binding LastUpdate, Converter={StaticResource TimestampToDateConverter}}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="11"
                                                       TextColor="#FFFFFF"/>
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Column="1"
                                                BackgroundColor="#0A0A0A"
                                                StrokeThickness="0"
                                                Padding="8,6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="PWM"
                                                       FontFamily="OpenSansRegular"
                                                       FontSize="10"
                                                       TextColor="#6B6B6B"/>
                                                <Label Text="{Binding Pwm, StringFormat='{0}/255'}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="11"
                                                       TextColor="#FFFFFF"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>